# CHAMP-LM Research Platform Configuration

# Trading Symbol
SYMBOL=btcusdt

# Binance WebSocket (auto-generated if empty)
WS_BINANCE=

# Batch Processing
BATCH_SEC=30
HIST_POINTS=360

# LLM Configuration
MAX_RETRIES=3
RETRY_BACKOFF=1.5

# Circuit Breaker Settings
CB_FAILURES=5
CB_TIMEOUT=60

# Storage
DATA_ROOT=/data
ARCHIVE_CAP=12000
MAX_TEXT=2000

# Research Configuration
SIGNIFICANCE_THRESHOLD=0.05
NOVELTY_THRESHOLD=0.7

# Health & Monitoring
HEALTH_CHECK_INTERVAL=30
METRICS_PORT=9090
ALERT_WEBHOOK=

# Optional: Local Model Endpoints (defaults to ollama services)
# MODEL_ENDPOINTS=llama3_8b:http://llama3-8b:8001/generate,mistral_7b:http://mistral-7b:8002/generate

# Logging
LOG_LEVEL=INFO
